# Copia este archivo a ".env" (está en .gitignore) y cambia TODOS los valores.
# Genera secretos con:  openssl rand -base64 48

# Base de datos propia del módulo (usuario y contraseña exclusivos de este módulo)
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=CAMBIA-ESTA-CLAVE-DE-BD
DB_PORT=5435

# Firma de los tokens: debe ser EXACTAMENTE el mismo valor que JWT_SECRET del Gateway (>= 32 caracteres)
JWT_SECRET=CAMBIA-ESTE-SECRETO-POR-UNO-DE-AL-MENOS-32-CARACTERES
JWT_EXPIRES_IN=1h

# Usuario ADMIN inicial (se crea al arrancar si no existe)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA-ESTA-CLAVE-ADMIN
